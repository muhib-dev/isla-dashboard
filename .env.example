# mock (default, in-memory sample data) | http (real ISLA API)
DATA_SOURCE=mock

# Required when DATA_SOURCE=http
ISLA_API_URL=
ISLA_API_TOKEN=

# Simulated latency for the mock adapter (ms) so loading states are visible
MOCK_LATENCY_MS=250

# Public ISLA site used for Store / Job Portal / Membership links
NEXT_PUBLIC_ISLA_SITE_URL=https://theisla.org

# Contact (email or URL) for the Nominatim User-Agent — required by their usage policy.
# Leave empty to disable address / place-name geocoding (ZIP and city pins still work).
GEOCODER_CONTACT=
# Override to use a self-hosted Nominatim
# GEOCODER_URL=https://nominatim.openstreetmap.org
